# ── Gemma 4 / Gemini API ──────────────────────────────────────────────────────
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMMA_MODEL=gemma-4

# ── ElevenLabs (TTS + STT) ────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_flash_v2_5

# ── Firebase (Storage + Firestore) ────────────────────────────────────────────
# Leave empty to disable Firebase (events stored locally in data/events/)
FIREBASE_SERVICE_ACCOUNT=firebase-service-account.json
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# ── Hardware node IPs ─────────────────────────────────────────────────────────
GLOVE_IP=192.168.4.11
GLASSES_IP=192.168.4.10
GLASSES_STREAM_URL=http://192.168.4.10:81/stream
GLOVE_STREAM_URL=http://192.168.4.11:81/stream

# ── Server / misc ─────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173
EVENTS_DIR=data/events
FALL_THRESHOLD_G=2.4
PRE_EVENT_SECONDS=10
POST_EVENT_SECONDS=10
IMU_UDP_HOST=0.0.0.0
IMU_UDP_PORT=9002
